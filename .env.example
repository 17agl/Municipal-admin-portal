# EcoSort AI — Municipal Admin Portal Environment Configuration (Example Template)

# Backend API URLs
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MUNICIPAL_BACKEND_URL=http://127.0.0.1:8001

# Portal Identification
VITE_PORTAL_NAME=EcoSort AI Municipal Command
VITE_PORTAL_VERSION=2.4.0
VITE_MUNICIPALITY_NAME=Delhi Capital Urban Development Authority

# Default GIS Map Center Coordinates
VITE_MAP_DEFAULT_LAT=28.6180
VITE_MAP_DEFAULT_LNG=77.2150
VITE_MAP_DEFAULT_ZOOM=13
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors | EcoSort AI Municipal GIS

# Operational SLA Thresholds (Hours)
VITE_SLA_P1_HOURS=4
VITE_SLA_P2_HOURS=12
VITE_SLA_P3_HOURS=24
VITE_SLA_P4_HOURS=48

# Telematics & Polling Intervals (Milliseconds)
VITE_TELEMETRY_REFRESH_INTERVAL=15000
VITE_SMART_BIN_ALERT_THRESHOLD=85
